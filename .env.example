# API
NODE_ENV=development
PORT=4000
JWT_ACCESS_SECRET=replace-with-a-real-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-real-refresh-secret-at-least-32-chars
DATABASE_URL=postgresql://app:app@postgres:5432/app?schema=public
TEST_DATABASE_URL=postgresql://app:app@postgres:5432/app_test?schema=public
REDIS_URL=redis://redis:6379
SMTP_URL=smtp://mailpit:1025
FRONTEND_URL=http://localhost:3000
API_URL=http://api:4000
SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# App runtime
APP_NAME=workspace
APP_VERSION=0.1.0
EXPOSE_INVITE_LINKS=true
WEB_PORT=3000
API_PORT=4000
