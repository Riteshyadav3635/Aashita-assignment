{
  "name": "workspace-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit/ordering.test.ts tests/unit/smoke.test.ts tests/integration/health.test.ts tests/integration/db-ordering.test.ts tests/integration/auth-and-rbac.test.ts tests/integration/boards-and-lists.test.ts tests/integration/activity-and-search.test.ts tests/integration/realtime.test.ts tests/integration/dashboard-cache.test.ts",
    "test:unit": "vitest run tests/unit/ordering.test.ts tests/unit/smoke.test.ts",
    "test:integration": "vitest run tests/integration/health.test.ts tests/integration/db-ordering.test.ts tests/integration/auth-and-rbac.test.ts tests/integration/boards-and-lists.test.ts tests/integration/activity-and-search.test.ts tests/integration/realtime.test.ts tests/integration/dashboard-cache.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "fractional-indexing": "4.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pino": "^9.1.0",
    "pino-http": "^1.1.0",
    "prisma": "6.19.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pino-http": "^6.1.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.15.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
